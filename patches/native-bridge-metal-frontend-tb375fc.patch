-- (id<MTLLibrary>)newLibraryWithFile:(NSString *)path error:(NSError **)error {
+static NSData *nbReadLibraryFile(NSString *path, NSError **error) {
  NSData *bytes=path?[NSData dataWithContentsOfFile:path options:NSDataReadingMappedIfSafe error:error]:nil;
+ if(bytes && bytes.length>0)return bytes;
+ if(!path)return nil;
+ const int fd=open(path.fileSystemRepresentation,O_RDONLY);
+ if(fd<0)return nil;
+ struct stat st={};
+ if(fstat(fd,&st)!=0 || st.st_size<=0){close(fd);return nil;}
+ NSMutableData *buf=[NSMutableData dataWithLength:(NSUInteger)st.st_size];
+ if(!buf){close(fd);return nil;}
+ uint8_t *dst=(uint8_t *)buf.mutableBytes;
+ off_t off=0;
+ while(off<st.st_size){
+  size_t want=(size_t)MIN((off_t)(1<<20),st.st_size-off);
+  ssize_t got=pread(fd,dst+off,want,off);
+  if(got<=0){close(fd);return nil;}
+  off+=got;
+ }
+ close(fd);
+ if(error)*error=nil;
+ return buf;
+}
