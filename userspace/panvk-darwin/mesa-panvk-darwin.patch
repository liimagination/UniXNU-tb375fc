+struct pan_kmod_bo *
+pan_kmod_bo_import_host(struct pan_kmod_dev *dev, void *host_ptr, uint64_t size)
+{
+   struct pan_kmod_bo *bo = NULL;
+   struct pan_kmod_bo **slot;
+   uint32_t handle = 0;
+   uint64_t aligned_size = 0;
+
+   simple_mtx_lock(&dev->handle_to_bo.lock);
+
+   if (panthor_darwin_import_host_handle(dev->fd, host_ptr, size, &handle,
+                                         &aligned_size) != 0)
+      goto err_unlock;
+
+   slot = util_sparse_array_get(&dev->handle_to_bo.array, handle);
+   if (!slot)
+      goto err_close_handle;
+
+   if (*slot) {
+      bo = *slot;
+      p_atomic_inc(&bo->refcnt);
+   } else {
+      bo = dev->ops->bo_import(dev, handle, aligned_size);
+      if (!bo)
+         goto err_close_handle;
+      *slot = bo;
+   }
+
+   simple_mtx_unlock(&dev->handle_to_bo.lock);
+   return bo;
+
+err_close_handle:
+   drmCloseBufferHandle(dev->fd, handle);
+err_unlock:
+   simple_mtx_unlock(&dev->handle_to_bo.lock);
+   return NULL;
+}
+#endif
